{
  "name": "@agora/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/src/index.js",
  "scripts": {
    "build": "tsc -p . && tsc -p src/client",
    "typecheck": "tsc -p . --noEmit && tsc -p src/client --noEmit",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test $(find dist/test -name '*.test.js')"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@agora/acp": "0.0.0",
    "@agora/domain": "0.0.0",
    "@agora/session-runtime-control": "0.0.0",
    "@agora/store-pg": "0.0.0",
    "@apidevtools/swagger-parser": "12.1.0",
    "ajv": "8.20.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
