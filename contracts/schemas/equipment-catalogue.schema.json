{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agora.invalid/contracts/equipment-catalogue.schema.json",
  "title": "EquipmentCatalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "resources"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "resources": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "x-uniqueBy": "resource",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "label",
          "description",
          "accessLevels"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "accessLevels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "x-uniqueBy": "access",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "access",
                "label"
              ],
              "properties": {
                "access": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                },
                "scopeSchema": {
                  "type": "object",
                  "description": "Safe JSON Schema for user-visible resource scope intent.",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
