{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agora.invalid/contracts/custody-manifest.schema.json",
  "title": "CustodySnapshotManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "sessionId",
    "generation",
    "captureRequestId",
    "formatId",
    "formatVersion",
    "adapterVersion",
    "syncedThroughSeq",
    "contentType",
    "sha256",
    "sizeBytes",
    "createdAt"
  ],
  "properties": {
    "snapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "captureRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "formatId": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "syncedThroughSeq": {
      "type": "integer",
      "minimum": 0
    },
    "contentType": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
