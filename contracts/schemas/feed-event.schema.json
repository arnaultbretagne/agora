{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agora.invalid/contracts/feed-event.schema.json",
  "title": "WorkstreamFeedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workstreamId",
    "position",
    "throughWorkstreamSeq",
    "operation",
    "payload"
  ],
  "properties": {
    "workstreamId": {
      "type": "string",
      "format": "uuid"
    },
    "position": {
      "type": "integer",
      "minimum": 1
    },
    "throughWorkstreamSeq": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "enum": [
        "upsert",
        "remove",
        "status",
        "reset"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "upsert"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://agora.invalid/contracts/workstream-item.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "remove"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "subjectId",
              "state"
            ],
            "properties": {
              "subject": {
                "enum": [
                  "command",
                  "session",
                  "runtime",
                  "projection"
                ]
              },
              "subjectId": {
                "type": "string"
              },
              "state": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "reset"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "refetch"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "retention_gap",
                  "projection_rebuild",
                  "projection_version_changed"
                ]
              },
              "refetch": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
