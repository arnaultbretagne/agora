{
  "agentId": "claude-code",
  "version": "2026.08.01",
  "label": "Claude Code",
  "description": "Missing acpCommand — must be rejected.",
  "imageDigest": "ghcr.io/arnaultbretagne/agent-claude-code@sha256:4587f01345c5f2adf2f9fec56946638469d8ef8704a2124434232c55ccddc1a5",
  "bridge": { "transport": "websocket", "listenPort": 8443 },
  "stableAcpVersions": [1],
  "custody": {
    "driverId": "claude-code-fs",
    "readFormats": [{ "formatId": "claude-code-fs", "formatVersion": "1" }],
    "writeFormat": { "formatId": "claude-code-fs", "formatVersion": "1" },
    "captureRoots": ["/home/node/.claude"],
    "credentialExclusions": ["/home/node/.claude/.credentials.json"],
    "consistency": "process-quiescence",
    "restoreCollision": "fail-if-present",
    "maxBytes": 536870912
  },
  "resources": {
    "requests": { "cpu": "500m", "memory": "512Mi" },
    "limits": { "cpu": "2", "memory": "2Gi", "ephemeralStorage": "4Gi" }
  },
  "health": { "path": "/healthz", "initialDelaySeconds": 2, "timeoutSeconds": 1 },
  "rollout": "enabled"
}
