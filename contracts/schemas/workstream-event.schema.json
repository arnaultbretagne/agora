{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agora.invalid/contracts/workstream-event.schema.json",
  "title": "WorkstreamEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workstreamId",
    "workstreamSeq",
    "sessionId",
    "sessionSeq",
    "direction",
    "rpcKind",
    "envelope",
    "purpose",
    "ingestMode",
    "observedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workstreamId": {
      "type": "string",
      "format": "uuid"
    },
    "workstreamSeq": {
      "type": "integer",
      "minimum": 1
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionSeq": {
      "type": "integer",
      "minimum": 1
    },
    "direction": {
      "enum": [
        "client_to_agent",
        "agent_to_client"
      ]
    },
    "rpcKind": {
      "enum": [
        "request",
        "response",
        "notification"
      ]
    },
    "method": {
      "type": [
        "string",
        "null"
      ]
    },
    "rpcId": {},
    "envelope": {
      "type": "object",
      "description": "Complete stable ACP v1 JSON-RPC envelope; validated with the official SDK."
    },
    "commandId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causationEventId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "purpose": {
      "enum": [
        "user",
        "handoff",
        "protocol"
      ]
    },
    "entityKind": {
      "type": [
        "string",
        "null"
      ]
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "transportObservationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opaque bridge delivery identity used only for recovered-frame deduplication."
    },
    "ingestMode": {
      "enum": [
        "live",
        "load_replay",
        "recovered"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
